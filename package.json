{
  "name": "frantssuy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm generate:articles && varlock run -- vp dev --port 3000",
    "prebuild": "pnpm generate:cv",
    "build": "pnpm generate:articles && varlock run -- vp build && varlock run -- vp pack",
    "start": "varlock run -- node .output/server/index.mjs",
    "preview": "vp preview",
    "check": "pnpm generate:localization && APP_ENV=test vp check",
    "knip": "pnpm generate:localization && knip",
    "test": "pnpm generate:localization && APP_ENV=test vp test",
    "test:screenshots": "playwright test",
    "test:screenshots:update": "playwright test --update-snapshots",
    "generate:articles": "node --import=tsx scripts/generate-articles.ts",
    "generate:article-social": "pnpm generate:articles",
    "articles:sync": "varlock run -- node .output/server/articles-sync.mjs .output/server/articles.json",
    "articles:sync:dev": "pnpm generate:articles && varlock run -- node --import=tsx scripts/articles-sync.ts",
    "generate:favicon": "node scripts/generate-favicon.ts",
    "generate:localization": "node scripts/generate-localization.ts",
    "generate:cv": "pnpm generate:localization && node scripts/generate-cv.ts",
    "generate:routes": "tsr generate",
    "generate:social": "node scripts/generate-social.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "varlock run -- drizzle-kit generate",
    "db:migrate": "varlock run -- drizzle-kit migrate",
    "db:studio": "varlock run -- drizzle-kit studio"
  },
  "dependencies": {
    "@ark-ui/solid": "5.39.3",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@inlang/paraglide-js-solid": "1.0.3",
    "@nanostores/query": "0.3.4",
    "@nanostores/solid": "1.1.1",
    "@orpc/client": "2.0.0-beta.46",
    "@orpc/contract": "2.0.0-beta.46",
    "@orpc/openapi": "2.0.0-beta.46",
    "@orpc/ratelimit": "2.0.0-beta.46",
    "@orpc/server": "2.0.0-beta.46",
    "@stylexjs/stylex": "0.19.1",
    "@tabler/icons-solidjs": "3.49.0",
    "@tanstack/solid-pacer": "0.24.0",
    "@tanstack/solid-router": "1.170.43",
    "@tanstack/solid-start": "1.169.4",
    "@varlock/vite-integration": "^1.5.4",
    "drizzle-orm": "1.0.0-rc.5",
    "nanostores": "1.5.5",
    "nitro": "3.0.260903-beta",
    "pg": "8.23.1",
    "posthog-js": "1.438.24",
    "solid-js": "1.9.17",
    "valibot": "1.5.0",
    "varlock": "^1.23.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.9",
    "@inlang/paraglide-js": "2.29.2",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "1.64.1",
    "@posthog/rollup-plugin": "1.6.2",
    "@stylexjs/babel-plugin": "0.19.1",
    "@stylexjs/eslint-plugin": "0.19.1",
    "@stylexjs/postcss-plugin": "0.19.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@takumi-rs/core": "2.18.2",
    "@tanstack/highlight": "^1.2.0",
    "@tanstack/router-cli": "^1.167.46",
    "@types/pg": "8.23.1",
    "@vitest/browser-playwright": "catalog:",
    "drizzle-kit": "1.0.0-rc.5",
    "knip": "6.43.0",
    "playwright": "1.64.1",
    "postcss": "8.5.32",
    "railway": "3.16.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plugin-solid": "2.11.14",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.9.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  }
}
