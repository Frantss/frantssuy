{
  "name": "frantssuy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm generate:articles && varlock run -- portless run cf dev",
    "prebuild": "pnpm generate:cv",
    "build": "pnpm generate:articles && varlock run -- cf build",
    "preview": "varlock run -- vp preview",
    "check": "pnpm generate:localization && pnpm cf:types && APP_ENV=test vp check && tsc --project src/worker/tsconfig.json && tsc --project src/worker/tests/tsconfig.json",
    "knip": "pnpm generate:localization && pnpm cf:types && knip",
    "test": "pnpm generate:localization && pnpm cf:types && APP_ENV=test vp test run && pnpm test:workers",
    "test:screenshots": "playwright test",
    "test:screenshots:update": "playwright test --update-snapshots",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "cf:types": "cf workers types --include-runtime=false",
    "generate:articles": "node --import=tsx scripts/generate-articles.ts",
    "generate:article-social": "pnpm generate:articles",
    "generate:favicon": "node scripts/generate-favicon.ts",
    "generate:localization": "node scripts/generate-localization.ts",
    "generate:cv": "pnpm generate:localization && node scripts/generate-cv.ts",
    "generate:routes": "tsr generate",
    "generate:social": "node scripts/generate-social.ts"
  },
  "dependencies": {
    "@ark-ui/solid": "5.40.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@inlang/paraglide-js-solid": "1.0.4",
    "@nanostores/query": "0.3.4",
    "@nanostores/solid": "1.1.1",
    "@orama/stemmers": "^3.1.18",
    "@orama/stopwords": "^3.1.18",
    "@orpc/client": "2.0.0-beta.46",
    "@orpc/cloudflare": "2.0.0-beta.46",
    "@orpc/contract": "2.0.0-beta.46",
    "@orpc/openapi": "2.0.0-beta.46",
    "@orpc/ratelimit": "2.0.0-beta.46",
    "@orpc/server": "2.0.0-beta.46",
    "@stylexjs/stylex": "0.19.1",
    "@tabler/icons-solidjs": "3.50.0",
    "@tanstack/router-core": "1.171.39",
    "@tanstack/solid-pacer": "0.24.0",
    "@tanstack/solid-router": "1.170.43",
    "@tanstack/solid-start": "1.169.4",
    "@varlock/vite-integration": "^1.5.5",
    "minisearch": "^7.2.0",
    "nanostores": "1.5.5",
    "posthog-js": "1.444.4",
    "solid-js": "1.9.18",
    "valibot": "1.5.0",
    "varlock": "^1.24.0"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.11",
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@inlang/paraglide-js": "3.0.0",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "1.64.1",
    "@posthog/rollup-plugin": "1.6.2",
    "@stylexjs/babel-plugin": "0.19.1",
    "@stylexjs/eslint-plugin": "0.19.1",
    "@stylexjs/postcss-plugin": "0.19.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@takumi-rs/core": "2.19.0",
    "@tanstack/highlight": "^1.2.11",
    "@tanstack/router-cli": "^1.167.46",
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "catalog:",
    "cf": "1.0.0-beta.27",
    "knip": "6.44.1",
    "playwright": "1.64.1",
    "postcss": "8.5.32",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plugin-solid": "2.11.15",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.9.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  }
}
